{
  "version": 2,
  "regions": ["sin1"],
  "framework": "vite",
  "installCommand": "npm --prefix frontend ci --no-audit --no-fund",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "backend/app/**",
      "excludeFiles": "{frontend/node_modules/**,backend/.venv/**,backend/app/tests/**,backend/app/ml/**,.github-sync/**}"
    }
  },
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/index.py"},
    {"source": "/docs", "destination": "/api/index.py"},
    {"source": "/openapi.json", "destination": "/api/index.py"},
    {"source": "/((?!assets/).*)", "destination": "/index.html"}
  ]
}
